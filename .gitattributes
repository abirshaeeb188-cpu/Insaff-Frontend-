# Git LFS disabled on purpose: Vercel does not download LFS files by default,
# so images/logo were deployed as tiny text pointers and showed as broken.
# Mark binaries so git never touches them.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
